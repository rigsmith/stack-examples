{
  "$schema": "https://rigsmith.dev/schemas/rig-stack.json",

  "repos": {
    // A library you forked. Work leaves it as a pull request to its upstream.
    "lib": {
      "upstream": "github.com/acme/pty-core",
      "fork": "github.com/you/pty-core"
    },

    // Your own app. "owned" is what makes `rig stack push` apply to it, so its
    // commits go back with their history instead of squashed.
    "app": {
      "upstream": "github.com/you/term-app",
      "fork": "github.com/you/term-app",
      "owned": true
    }
  }
}
